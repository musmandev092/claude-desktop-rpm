<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.anthropic.Claude</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LicenseRef-proprietary</project_license>
  <name>Claude</name>
  <summary>Anthropic's Claude desktop app</summary>
  <description>
    <p>Claude Desktop is Anthropic's official desktop app for chatting with Claude.</p>
    <p>This is an unofficial RPM: it downloads Anthropic's official Linux build at install time, checks it against a pinned SHA-256 and installs it unmodified.</p>
  </description>
  <launchable type="desktop-id">com.anthropic.Claude.desktop</launchable>
  <pkgname>claude-desktop</pkgname>
  <url type="homepage">https://github.com/musmandev092/claude-desktop-rpm</url>
  <screenshots>
    <screenshot type="default">
      <image type="source">https://musmandev092.github.io/claude-desktop-rpm/screenshots/main.png</image>
    </screenshot>
    <screenshot>
      <image type="source">https://musmandev092.github.io/claude-desktop-rpm/screenshots/code.png</image>
    </screenshot>
  </screenshots>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
